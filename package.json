{
  "name": "@darkmatter2222/opencode-relentless",
  "version": "2.0.0-beta.1",
  "description": "Persistent OpenCode goals with automatic recovery, discoverable commands, and evidence-backed completion.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "bin": {
    "opencode-goal": "bin/opencode-goal.js",
    "opencode-relentless": "./bin/opencode-goal.js",
    "opencode-relentless-runner": "./bin/opencode-relentless-runner.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.tr.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkmatter2222/opencode-goal.git"
  },
  "homepage": "https://github.com/darkmatter2222/opencode-goal#readme",
  "bugs": {
    "url": "https://github.com/darkmatter2222/opencode-goal/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/unit-tests.mjs",
    "eval": "npm run build && node scripts/eval-corpus.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "npm run check && npm test && npm run eval && npm run docs:check && npm run package:smoke",
    "prepublishOnly": "npm run release:check",
    "canary:host": "node --import ./scripts/host-canary-bootstrap.mjs scripts/host-canary.mjs",
    "canary:compaction": "node --import ./scripts/host-canary-bootstrap.mjs scripts/host-compaction-canary.mjs && node --import ./scripts/host-canary-bootstrap.mjs scripts/host-auto-compaction-canary.mjs",
    "canary:semantic": "node --import ./scripts/host-canary-bootstrap.mjs scripts/host-semantic-canary.mjs",
    "canary:steering": "node --import ./scripts/host-canary-bootstrap.mjs scripts/host-steering-canary.mjs",
    "canary:progress": "node --import ./scripts/host-canary-bootstrap.mjs scripts/host-progress-canary.mjs",
    "canary:restart": "node --import ./scripts/host-canary-bootstrap.mjs --import ./scripts/host-restart-hard-crash.mjs scripts/host-restart-canary.mjs",
    "pack:check": "npm pack --dry-run",
    "docs:check": "npm run build && node scripts/docs-check.mjs",
    "docs:update": "npm run build && node scripts/docs-check.mjs --write"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-goal",
    "opencode-goals",
    "goal-plugin",
    "goal-mode",
    "persistent-goals",
    "autonomous-agent",
    "ai-coding-agent",
    "coding-agent",
    "multi-turn",
    "long-running-agent",
    "completion-verification",
    "host-verified",
    "restart-recovery",
    "slash-command",
    "codex-style",
    "agent",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "opencode": ">=1.4.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
